# ALL of these are OPTIONAL. The server runs fully (voice + push) with no .env at all:
# push keys are auto-generated on first boot and saved to data/vapid.json.

# Pin your own VAPID keys (npm run generate-vapid) instead of auto-generated ones:
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=

# Contact for push services (recommended once public):
#VAPID_SUBJECT=mailto:you@example.com

# Shared secret: set the same value in the app's "App key" field to lock writes:
#APP_KEY=

# Comma-separated CORS allow-list (empty = allow all origins):
#ALLOWED_ORIGINS=https://ummatprayer.netlify.app
