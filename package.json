{
  "name": "sabr-push-server",
  "version": "2.0.0",
  "private": true,
  "description": "Voice (recite) + background-push server for the Sabr app. /tts voices hadith & dhikr aloud; push fires prayer/ayah/hadith reminders even when the app is closed.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "generate-vapid": "node scripts/generate-vapid.js",
    "keys": "web-push generate-vapid-keys"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-tts-api": "^2.0.2",
    "helmet": "^7.1.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "axios": "^1.19.0"
  }
}
